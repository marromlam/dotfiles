#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # Prefix each folder with a sort key so existing tmux sessions are shown
    # before folders that do not have a session yet.  Keep the path hidden from
    # the picker, then remove the key after selection.
    candidates=$(find ~/Workspaces/ ~/Workspaces/work ~/Workspaces/personal \
        -mindepth 1 -maxdepth 1 -type d |
        while IFS= read -r folder; do
            session_name=$(basename "$folder" | tr . _)
            if tmux has-session -t="$session_name" 2>/dev/null; then
                sort_key=0
            else
                sort_key=1
            fi
            printf '%s\t%s\n' "$sort_key" "$folder"
        done |
        sort -t $'\t' -k1,1n -k2,2)

    selected=$(printf '%s\n' "$candidates" |
        fzf --no-sort --delimiter=$'\t' --with-nth=2.. \
            --height 100% --layout=reverse --prompt="Tmux Sessions> ")
    selected=${selected#*$'\t'}
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2>/dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

tmux switch-client -t $selected_name

# vim: ft=bash
